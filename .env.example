DATABASE_URL=postgresql+psycopg://converter:CHANGE_ME@localhost:5432/file_converter
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
FRONTEND_ORIGIN=http://localhost:5173
STORAGE_DIR=.runtime/storage
MAIL_MODE=local
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
MAIL_FROM=noreply@fileconverter.local
SESSION_HOURS=24
RETENTION_HOURS=24
MAX_UPLOAD_MB=50
NOMINAL_THRESHOLD=20
DEMO_USER_PASSWORD=
DEMO_ADMIN_PASSWORD=
WEKA_JAR=.runtime/weka-3.8.6.jar
JAVA_EXECUTABLE=java
VERIFICATION_TIMEOUT_SECONDS=30
# Optional cloud deployment settings; local defaults remain unchanged.
ENVIRONMENT=local
STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=converter-files
# FRONTEND_DIST=frontend/dist  # Set only when serving a built frontend through FastAPI.
BREVO_API_KEY=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
CLEANUP_INTERVAL_SECONDS=30
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
